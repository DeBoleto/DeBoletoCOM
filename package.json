        "@types/node": "^26.1.0",
        "@vitejs/plugin-vue": "^6.0.4",
        "autoprefixer": "^10.4.16",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^3.1",
        "postcss": "^8.4.32",
        "prettier": "^3.9.6",
        "tailwindcss": "^4.3.2",
        "typescript": "^5.9.3",
        "vite": "^8.0.0",
        "vue": "^3.3.13",
        "vue-tsc": "^3.3.6"
    },
    "dependencies": {
        "@vueuse/core": "^14.3.0",
