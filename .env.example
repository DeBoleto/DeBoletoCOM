APP_NAME=DeBoletoMX
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost/deboletov2/public
APP_LOCALE=es
APP_FALLBACK_LOCALE=es

LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=deboleto
DB_USERNAME=
DB_PASSWORD=

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_DB=0
REDIS_CACHE_DB=1

CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=log

MAIL_MAILER=smtp
MAIL_HOST=mail.deboleto.mx
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

STRIPE_KEY=
STRIPE_SECRET=
OPENPAY_MERCHANT_ID=
OPENPAY_PRIVATE_KEY=
OPENPAY_PUBLIC_KEY=
OPENPAY_PRODUCTION=false
# Credenciales Basic Auth configuradas en el webhook del panel de OpenPay
OPENPAY_WEBHOOK_USER=
OPENPAY_WEBHOOK_PASSWORD=

TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
TWILIO_WHATSAPP_FROM=

VITE_APP_NAME="${APP_NAME}"

USE_LOCAL_JSON=

# Taquilla (boxoffice)
BOXOFFICE_TIMEZONE=America/Mexico_City
BOXOFFICE_ENFORCE_MENU_PRIVILEGES=true

# WhatsApp (UltraMSG)
ULTRAMSG_INSTANCE=
ULTRAMSG_TOKEN=

# Login de clientes por código (Stytch)
STYTCH_PROJECT_ID=
STYTCH_SECRET=
STYTCH_BASE_URL=https://api.stytch.com/v1

# Integraciones de la compra web
CHECKOUT_TERMS_URL=
CHECKOUT_PRIVACY_URL=
FACEBOOK_GRAPH_VERSION=v21.0
LIGA_MX_URL=
LIGA_ID=
